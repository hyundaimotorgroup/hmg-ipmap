# Local development environment variables.
# Copy this file to .env in the same directory and set your own values:
#
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored — never commit it.
# These values are only used for local Docker development.

# PostgreSQL superuser credentials (used by Docker to initialize the database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ipmap

# Application user credentials (must match application-local.properties)
APP_USER_PASSWORD=change-me
